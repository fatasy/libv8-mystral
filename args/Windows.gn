is_debug=false
is_component_build=false
v8_monolithic=true

# v8_enable_webassembly=true
v8_enable_i18n_support=false
v8_enable_test_features=false

v8_use_external_startup_data=false

symbol_level=0
strip_debug_info=true
treat_warnings_as_errors=false


# The configuration V8 is actually built and tested in, pinned rather than
# inherited.
#
# Every configuration problem in this port came from a default that moved
# between 13.1 and 15.2 while this file said nothing. So these are explicit
# even where they match today's defaults.
#
# The platform standard library is no longer an option here. V8 15.2 does not
# compile against it: Torque and the C++ structs disagree on object layout --
# JSAtomicsMutex at '40 == 36' without pointer compression, JSInterceptorMap at
# a flat three-byte shift with it. Chromium's libc++ is what the V8 team builds
# against, so it is what works.
#
# Consumers therefore need libc++ too, which is why archive.bat folds it into
# the monolith rather than leaving 358 unresolved std::__Cr symbols for whoever
# links this.
use_custom_libcxx=true
v8_enable_pointer_compression=true
v8_enable_sandbox=true
